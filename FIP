<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>FLIGHT IN PROGRESS</title>
  <link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@500;700&display=swap" rel="stylesheet">
  <style>
    body {
      font-family: 'Orbitron', monospace;
      background-color: #0e1117;
      color: #f5f5f5;
      margin: 0;
      padding: 1rem;
    }
    h1 {
      font-size: 1.5rem;
      text-align: center;
      margin-top: 2rem;
    }
    input[type="text"] {
      width: 90%;
      max-width: 400px;
      padding: 0.8rem;
      margin: 1rem auto;
      display: block;
      border-radius: 8px;
      border: none;
      font-size: 1rem;
      background-color: #1e2633;
      color: #f5f5f5;
    }
    button {
      display: block;
      margin: 0 auto 2rem;
      padding: 0.8rem 2rem;
      background-color: #f5f5f5;
      color: #0e1117;
      border: none;
      font-size: 1rem;
      border-radius: 8px;
      cursor: pointer;
    }
    .ticket {
      text-align: center;
      border: 1px solid #444;
      border-radius: 10px;
      padding: 1rem;
      background-color: #1e2633;
      margin-bottom: 2rem;
    }
    .logbook {
      margin-top: 1rem;
    }
    .log-entry {
      background-color: #1e2633;
      border-radius: 10px;
      padding: 1rem;
      margin-bottom: 1rem;
    }
  </style>
</head>
<body>
  <h1>What's your emotion today?</h1>
  <input type="text" id="emotionInput" placeholder="e.g. grateful / excited / confused" />
  <button onclick="handleEmotion()">Record</button>

  <div class="ticket" id="ticket" style="display: none;"></div>

  <div class="logbook">
    <h2>LOGBOOK</h2>
    <div id="log"></div>
  </div>

  <script>
    const ticketDiv = document.getElementById("ticket");
    const logDiv = document.getElementById("log");

