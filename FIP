    function handleEmotion() {
      const emotion = document.getElementById("emotionInput").value.trim();
      if (!emotion) return;

      const altitude = Math.floor(Math.random() * 20000) + 2000;
      const latitude = (Math.random() * 180 - 90).toFixed(2);
      const longitude = (Math.random() * 360 - 180).toFixed(2);
      const interpretation = interpretEmotion(emotion, altitude);
      const date = new Date().toLocaleString();

      ticketDiv.style.display = "block";
      ticketDiv.innerHTML = `
        <strong>FLIGHT IN PROGRESS</strong><br><br>
        ${altitude.toLocaleString()} FT<br>
        LATITUDE ${latitude}° | LONGITUDE ${longitude}°<br><br>
        <em>${interpretation}</em><br><br>
        <hr style='margin: 1rem 0; border: none; border-top: 1px dashed #888;'>
        <small style='color: #ccc;'>Altitude (FT): Represents how intense the feeling is.<br>
        Latitude & Longitude: Emotional position in your inner sky.<br>
        Inspired by Jeppesen flight charts used by real pilots.<br><br>
        Suggested next route: Take a moment to reflect and log again tomorrow.</small>
      `;

      const logEntry = document.createElement("div");
      logEntry.className = "log-entry";
      logEntry.innerHTML = `<strong>${emotion.toUpperCase()}</strong><br>${interpretation}<br>${latitude}°, ${longitude}°<br>${altitude.toLocaleString()} FT`;
      logDiv.prepend(logEntry);
    }
  </script>
<div style="text-align:center; margin-top: 3rem;">
  <h3>Share your flight!</h3>
  <p style="color: #aaa;">Screenshot your ticket and share it to Instagram Story</p>
  <button onclick="alert('Image export coming soon')" style="padding: 0.7rem 1.5rem; font-size: 1rem; border-radius: 8px; border: none; background-color: #f5f5f5; color: #0e1117; cursor: pointer;">Save to Gallery</button>
</div>
</body>
</html>
